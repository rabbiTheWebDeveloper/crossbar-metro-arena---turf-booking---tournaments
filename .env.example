# ---------------------------------------------------------------------------
# Crossbar Metro Arena - environment template
# Copy to .env and fill in real values. NEVER commit real secrets to git.
# ---------------------------------------------------------------------------

# MongoDB (Atlas or local)
MONGODB_CONNECTION_STRING=mongodb+srv://rabbifajracademy:rabbifajracademy@cluster0.c6bc0x0.mongodb.net/crossbar

# Auth - generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to start in production without a real value.
JWT_SECRET=change_me_to_a_long_random_string

# Optional: Super password that allows logging into any active user account (any role) via mobile number or email (min 8 chars).
# Leave empty to disable. Keep secret and NEVER commit the real value to git.
SUPER_PASSWORD=

# Public site URL (no trailing slash) - used for payment callbacks, canonical URLs, sitemap and JSON-LD
NEXT_PUBLIC_BASE_URL=https://bookcrossbar.com
APP_URL=https://bookcrossbar.com

# SEO (optional). Paste the token Google Search Console / Bing Webmaster Tools give you for the
# "HTML tag" verification method (only the content="..." value, not the whole tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# EPS (Easy Payment System - https://www.eps.com.bd) payment gateway
# Can also be configured inside Admin -> Settings -> EPS Payment Gateway
# (values saved there take priority over these).
# EPS_USERNAME must be an email; EPS_MERCHANT_ID and EPS_STORE_ID must be full 36-char UUIDs
# (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx) - the SDK rejects anything else.
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
EPS_MERCHANT_ID=
EPS_STORE_ID=
EPS_SANDBOX=true


# Optional: ImageKit for gallery uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional: email notifications
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Demo accounts are created by `node scripts/seed_demo_users.js`
# (password for all demo accounts: password123)
#   Admin    01711223344  -> /admin
#   Investor 01819556677  -> /investor
#   Player   01844332211  -> /customer

# Set to "true" ONLY on a demo/staging site: enables the 1-click demo role buttons (admin/investor/player with password123)
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=2MuVCaUpSG7QS9cYJyQg9cakKChgqbreskDInUtI_Xk

