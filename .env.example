# ---------------------------------------------------------------------------
# Crossbar Metro Arena - environment template
# Copy to .env and fill in real values. NEVER commit real secrets to git.
# ---------------------------------------------------------------------------

# MongoDB (Atlas or local)
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crossbar

# Auth - generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to start in production without a real value.
JWT_SECRET=change_me_to_a_long_random_string

# Public site URL (no trailing slash) - used for payment callbacks and SEO
NEXT_PUBLIC_BASE_URL=https://bookcrossbar.com
APP_URL=https://bookcrossbar.com

# SSLCommerz payment gateway
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_SANDBOX=true

# Optional: ImageKit for gallery uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional: email notifications
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Demo accounts are created by `node scripts/seed_demo_users.js`
# (password for all demo accounts: password123)
#   Admin    01711223344  -> /admin
#   Investor 01819556677  -> /investor
#   Player   01844332211  -> /player

# Set to "true" ONLY on a demo/staging site: enables the 1-click demo role buttons (admin/investor/player with password123)
NEXT_PUBLIC_DEMO_MODE=false
